<!-- Garmin Connect phone app: Pomodorino > Settings. Only for people running their own server
     (server/README.md); everyone else uses "Connect Todoist" in the watch menu. -->
<settings>
    <setting propertyKey="@Properties.serverUrl" title="@Strings.ServerUrlTitle" prompt="@Strings.ServerUrlPrompt">
        <settingConfig type="alphaNumeric"/>
    </setting>
    <setting propertyKey="@Properties.apiKey" title="@Strings.ApiKeyTitle">
        <settingConfig type="alphaNumeric"/>
    </setting>
</settings>
